generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  tradeName String?
  siret     String?
  vatNumber String?
  isDemo    Boolean  @default(false)
  /// Affiché sur la page de connexion / shell
  brandName String?
  brandTagline String?
  loginHeadline String?
  loginSubheadline String?
  loginFooterText String?
  /// URL ou data-URL (logo)
  logoUrl String?
  /// Grande image panneau gauche (connexion)
  loginHeroImageUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  depots      Depot[]
  users       UserAccount[]
  groups      Group[]
  employees   Employee[]
  drivers     Driver[]
  customers   Customer[]
  vehicles    Vehicle[]
  vehicleCategories VehicleCategory[]
  locations   Location[]
  calendars   OperatingCalendar[]
  courses     Course[]
  services    Service[]
  quotes      Quote[]
  orders      Order[]
  missions    Mission[]
  assignments Assignment[]
  documents   GeneratedDocument[]
  threads     MessageThread[]
  incidents   QualityEvent[]
  leaves      LeaveRequest[]
  rests       PlannedRest[]
  alerts      OpsAlert[]
  invitations AccountInvitation[]
  permissions Permission[]
  itineraries Itinerary[]
  rosters     Roster[]
  theoreticalAssignments TheoreticalAssignment[]
  driverUnavs DriverUnavailability[]
  vehicleUnavs VehicleUnavailability[]
  dressingScenarios ServiceDressingScenario[]
  dressingRuns ServiceDressingRun[]
  timeBlocks  ServiceTimeBlock[]
  publicationBatches PlanningPublicationBatch[]
  invoices    Invoice[]
  payments    Payment[]
  credits     CustomerCredit[]
  prepRules   PrePayrollRule[]
  prepDaily   PrePayrollDailyLine[]
  prepWeekly  PrePayrollWeeklyLine[]
  prepMonthly PrePayrollMonthlyLine[]
  payrollCounters PayrollCounter[]
  payrollExports PayrollExportBatch[]
  leaveBalances LeaveBalance[]
  hrInterviews HrInterview[]
  trainingCourses TrainingCourse[]
  trainingSessions TrainingSession[]
  trainingEnrollments TrainingEnrollment[]
  payslips Payslip[]
  payrollBonuses PayrollBonus[]
  maintenanceAlerts MaintenanceAlert[]
  repairRequests RepairRequest[]
  workOrders  WorkOrder[]
  parts       Part[]
  stockMoves  StockMovement[]
  purchaseOrders PurchaseOrder[]
  fuelTx      FuelTransaction[]
  qualityClasses QualityClassification[]
  budgets     Budget[]
  analyticsReports AnalyticsReport[]
  simulations Simulation[]
  clientRequests ClientQuoteRequest[]
  clientMessages ClientPortalMessage[]
  documentTemplates DocumentTemplate[]
}

/// Modèles de documents imprimables (devis, factures, planning, billets…)
model DocumentTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// quote | invoice | planning | collective_ticket | order
  kind        String
  key         String
  name        String
  description String?
  /// HTML du corps avec variables {{...}}
  bodyHtml    String
  headerHtml  String?
  footerHtml  String?
  /// Mise en page visuelle (JSON blocs) — source de l’éditeur intuitif
  layoutJson  String?
  /// CSS print spécifique
  stylesCss   String?
  paperSize   String   @default("A4")
  /// portrait | landscape
  orientation String   @default("portrait")
  isDefault   Boolean  @default(false)
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId, kind])
}

model Depot {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  city      String?
  createdAt DateTime @default(now())

  employees Employee[]
  drivers   Driver[]
  vehicles  Vehicle[]
  memberships GroupMembership[]

  @@unique([companyId, code])
}

model UserAccount {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  email        String
  passwordHash String?
  displayName  String
  status       String   @default("not_created")
  mfaRequired  Boolean  @default(false)
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  /// Mot de passe temporaire émis par la RH — à changer à la 1ʳᵉ connexion
  mustChangePassword Boolean @default(false)
  tempPasswordSetAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     UserSession[]
  memberships  GroupMembership[]
  invitations  AccountInvitation[]
  employeeLink EmployeeAccountLink?
  auditEvents  AccessAuditEvent[] @relation("ActorEvents")
  messages     Message[]
  leaveRequests LeaveRequest[]
  readReceipts PortalReadReceipt[]
  serviceEvents DriverServiceEvent[]
  salesQuotes  Quote[] @relation("QuoteSalesperson")
  managedCustomers Customer[] @relation("CustomerAccountManager")
  salesOrders  Order[] @relation("OrderSalesperson")
  threadParticipations MessageThreadParticipant[]
  assignedThreads MessageThread[] @relation("AssignedThreads")
  driverThreads MessageThread[] @relation("DriverThreads")
  clientLink ClientAccountLink?
  clientMessages ClientPortalMessage[]

  @@unique([companyId, email])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenJti  String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

model AccountInvitation {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String
  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdById String?
  createdAt  DateTime @default(now())
}

model Group {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())

  memberships GroupMembership[]
  permissions GroupPermission[]

  @@unique([companyId, key])
}

model GroupMembership {
  id       String  @id @default(cuid())
  groupId  String
  group    Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  depotId  String?
  depot    Depot?  @relation(fields: [depotId], references: [id])
  createdAt DateTime @default(now())

  @@unique([groupId, userId, depotId])
}

model Permission {
  id        String  @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  key       String
  module    String
  resource  String
  action    String
  label     String
  sensitive Boolean @default(false)

  groups GroupPermission[]

  @@unique([companyId, key])
}

model GroupPermission {
  id           String @id @default(cuid())
  groupId      String
  group        Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scope        String @default("company")
  denied       Boolean @default(false)

  @@unique([groupId, permissionId])
}

model AccessAuditEvent {
  id         String   @id @default(cuid())
  companyId  String?
  actorId    String?
  actor      UserAccount? @relation("ActorEvents", fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  detailJson String?
  createdAt  DateTime @default(now())
}

model Employee {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  depotId        String?
  depot          Depot?   @relation(fields: [depotId], references: [id])
  matricule      String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  hiredAt        DateTime?
  endedAt        DateTime?
  /// CDI | CDD | interim | apprenti | saisonnier
  contractType   String?  @default("CDI")
  /// Classification convention collective transport
  classification String?
  echelon        String?
  contractHours  Float?
  /// Taux horaire de base (€)
  baseHourlyRate Float?
  /// Salaire mensuel brut de référence (€)
  baseMonthlySalary Float?
  birthDate      DateTime?
  birthPlace     String?
  addressLine1   String?
  addressLine2   String?
  postalCode     String?
  city           String?
  country        String?  @default("France")
  nationality    String?
  /// celibataire | marie | pacse | divorce | veuf
  familyStatus   String?
  dependentsCount Int     @default(0)
  /// Données sensibles — masquer sans hr:sensitive:read
  socialSecurityNumber String?
  iban           String?
  bic            String?
  emergencyContact String?
  emergencyPhone String?
  /// Convention collective
  collectiveAgreement String? @default("Transports routiers de voyageurs")
  jobCoefficient String?
  weeklyHours    Float?
  trialEndAt     DateTime?
  mutuelle       String?
  prevoyance     String?
  /// Temps plein | Temps partiel | Intermittent
  workTimeType   String?  @default("Temps plein")
  status         String   @default("active")
  sensitiveNotes String?
  rhNotes        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  driver        Driver?
  accountLink   EmployeeAccountLink?
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  interviews    HrInterview[]
  enrollments   TrainingEnrollment[]
  payslips      Payslip[]
  bonuses       PayrollBonus[]

  @@unique([companyId, matricule])
}

model Driver {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  employeeId      String   @unique
  employee        Employee @relation(fields: [employeeId], references: [id])
  depotId         String?
  depot           Depot?   @relation(fields: [depotId], references: [id])
  licenseNumber   String?
  /// Catégories permis : D, D1, DE…
  licenseCategories String? @default("D")
  licenseExpiresAt DateTime?
  /// Carte conducteur chronotachygraphe
  cardExpiresAt   DateTime?
  /// Formation continue obligatoire (FCO)
  fcoExpiresAt    DateTime?
  medicalExpiresAt DateTime?
  adrExpiresAt    DateTime?
  qualifications  String?
  maxDailyHours   Float?   @default(9)
  preferredNotes  String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments Assignment[]
  rests       PlannedRest[]
  serviceEvents DriverServiceEvent[]
  readReceipts PortalReadReceipt[]
  unavailabilities DriverUnavailability[]
  theoreticalAssignments TheoreticalAssignment[]
  rosterSlots RosterSlot[]
  dressingRuns ServiceDressingRun[]
}

model EmployeeAccountLink {
  id         String @id @default(cuid())
  employeeId String @unique
  employee   Employee @relation(fields: [employeeId], references: [id])
  userId     String @unique
  user       UserAccount @relation(fields: [userId], references: [id])
  portalRole String @default("driver")
  createdAt  DateTime @default(now())
}

model Customer {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  /// Code / référence client affichée
  reference        String?
  name             String
  tradeName        String?
  type             String   @default("enterprise")
  siret            String?
  vatNumber        String?
  email            String?
  phone            String?
  mobile           String?
  website          String?
  /// Adresse principale (siège / livraison)
  addressLine1     String?
  addressLine2     String?
  postalCode       String?
  city             String?
  country          String?  @default("France")
  /// Adresse de facturation (si différente)
  billingSameAsMain Boolean @default(true)
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingPostalCode String?
  billingCity      String?
  billingCountry   String?
  /// Legacy text field (conservé pour compat)
  billingAddress   String?
  paymentTermsDays Int      @default(30)
  paymentMethod    String?  @default("transfer")
  creditLimit      Float?
  currency         String?  @default("EUR")
  /// Champ alerte visible sur la fiche
  alertNote        String?
  notes            String?
  internalRemarks  String?
  preferredVehicleNotes String?
  preferredDriverNotes  String?
  /// Commercial dédié
  accountManagerId String?
  accountManager   UserAccount? @relation("CustomerAccountManager", fields: [accountManagerId], references: [id])
  /// Code APE / NAF
  apeCode          String?
  /// E-mail dédié facturation
  invoiceEmail     String?
  /// BC client obligatoire avant facturation
  requirePurchaseOrder Boolean @default(false)
  /// Pénalités de retard (% annuel, mention légale)
  latePenaltyRate  Float?   @default(10)
  /// Escompte pour paiement anticipé (%)
  earlyDiscountRate Float?  @default(0)
  /// none | pending | active | revoked
  sepaMandateStatus String? @default("none")
  /// N° marché / convention / contrat-cadre
  contractRef      String?
  contractEndsAt   DateTime?
  /// Notes tarifaires / grille négociée
  pricingNotes     String?
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contacts     Contact[]
  bankAccounts CustomerBankAccount[]
  destinations CustomerDestination[]
  documents    CustomerDocument[]
  comments     CustomerComment[]
  quotes       Quote[]
  orders       Order[]
  invoices     Invoice[]
  payments     Payment[]
  credits      CustomerCredit[]
  portalAccounts ClientAccountLink[]
  portalMessages ClientPortalMessage[]

  @@unique([companyId, reference])
  @@index([companyId, name])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  civility   String?
  firstName  String
  lastName   String
  email      String?
  phone      String?
  mobile     String?
  role       String?
  department String?
  isPrimary  Boolean  @default(false)
  isBilling  Boolean  @default(false)
  isOps      Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  quotes Quote[]
}

model CustomerBankAccount {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label         String   @default("Principal")
  bankName      String?
  iban          String?
  bic           String?
  accountHolder String?
  rum           String?
  isDefault     Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CustomerDestination {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String
  addressLine1 String?
  addressLine2 String?
  postalCode  String?
  city        String?
  country     String?  @default("France")
  contactName String?
  phone       String?
  notes       String?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomerDocument {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  category   String   @default("autre")
  fileName   String?
  mimeType   String?
  /// URL ou data-URL (upload local)
  fileUrl    String?
  notes      String?
  uploadedAt DateTime @default(now())
}

model CustomerComment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String?
  body       String
  createdAt  DateTime @default(now())
}

model VehicleCategory {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  defaultSeats Int     @default(53)
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  vehicles Vehicle[]
  quotes   Quote[]

  @@unique([companyId, code])
}

model Vehicle {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  depotId      String?
  depot        Depot?   @relation(fields: [depotId], references: [id])
  categoryId   String?
  category     VehicleCategory? @relation(fields: [categoryId], references: [id])
  fleetNumber  String
  plate        String
  vin          String?
  brand        String?
  model        String?
  year         Int?
  color        String?
  seats        Int      @default(53)
  energy       String   @default("diesel")
  /// available | in_service | maintenance | unavailable
  status       String   @default("available")
  odometerKm   Int      @default(0)
  /// Contrôle technique
  inspectionExpiresAt DateTime?
  insuranceExpiresAt  DateTime?
  /// Étalonnage chronotachygraphe
  tachographExpiresAt DateTime?
  nextMaintenanceAt   DateTime?
  nextMaintenanceKm   Int?
  hasPmr       Boolean  @default(false)
  hasToilet    Boolean  @default(false)
  hasWifi      Boolean  @default(false)
  optionsNotes String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments Assignment[]
  unavailabilities VehicleUnavailability[]
  theoreticalAssignments TheoreticalAssignment[]
  maintenanceAlerts MaintenanceAlert[]
  repairRequests RepairRequest[]
  workOrders WorkOrder[]
  fuelTx FuelTransaction[]

  @@unique([companyId, fleetNumber])
  @@unique([companyId, plate])
}

model Location {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  type      String   @default("stop")
  address   String?
  city      String?
  lat       Float?
  lng       Float?
  notes     String?
  accessMin Int      @default(5)
  createdAt DateTime @default(now())
}

model Itinerary {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  version     Int      @default(1)
  distanceKm  Float?
  durationMin Int?
  stopsJson   String   @default("[]")
  createdAt   DateTime @default(now())

  @@unique([companyId, code, version])
}

model OperatingCalendar {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  kind      String   @default("school")
  weekdays  String   @default("1,2,3,4,5")
  oddEven   String   @default("all")
  startDate DateTime?
  endDate   DateTime?
  exceptionsJson String @default("[]")
  createdAt DateTime @default(now())
}

model Course {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  kind        String   @default("regular")
  calendarId  String?
  distanceKm  Float?
  durationMin Int?
  createdAt   DateTime @default(now())

  segments   CourseSegment[]
  operations CourseOperation[]
  serviceLinks ServiceCourseLink[]
  theoreticalAssignments TheoreticalAssignment[]

  @@unique([companyId, code])
}

model CourseSegment {
  id         String @id @default(cuid())
  courseId   String
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sequence   Int
  kind       String @default("stop")
  locationId String?
  name       String
  plannedTime String?
  distanceKm Float?
}

model CourseOperation {
  id          String @id @default(cuid())
  courseId    String
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sequence    Int
  kind        String @default("run")
  label       String
  fromLocationId String?
  toLocationId   String?
  plannedStart String?
  plannedEnd   String?
  distanceKm   Float?
  durationMin  Int?
}

model Service {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  split       Boolean  @default(false)
  createdAt   DateTime @default(now())

  courseLinks ServiceCourseLink[]
  rosterSlots RosterSlot[]
  theoreticalAssignments TheoreticalAssignment[]
  dressingRuns ServiceDressingRun[]

  @@unique([companyId, code])
}

model ServiceCourseLink {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])
  sequence  Int
}

model Quote {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  salespersonId String?
  salesperson UserAccount? @relation("QuoteSalesperson", fields: [salespersonId], references: [id])
  /// email | phone | postal | portal | other
  source      String   @default("email")
  number      String
  caseType    String   @default("simple")
  /// draft | sent | accepted | refused | trashed | planning | invoicing
  status      String   @default("draft")
  title       String
  description String?
  /// aller_retour | aller_simple | mad | circuit | transfert | scolaire | evenementiel
  serviceType String   @default("aller_retour")
  departureAt DateTime?
  returnAt    DateTime?
  /// Horaires détaillés (stockés en DateTime complets)
  garageDepartureAt DateTime?
  presentationAt    DateTime?
  onSiteAt          DateTime?
  returnDepartureAt DateTime?
  returnGarageAt    DateTime?
  origin      String?
  originAddress String?
  destination String?
  destinationAddress String?
  distanceKm  Float?
  durationDays Float?  @default(1)
  vehicleCount Int     @default(1)
  vehicleCategoryId String?
  vehicleCategory VehicleCategory? @relation(fields: [vehicleCategoryId], references: [id])
  passengers  Int      @default(0)
  /// Prix catalogue / calculé (somme lignes ou forfait)
  amountHt    Float    @default(0)
  /// Prix proposé au client
  proposedPriceHt Float @default(0)
  vatRate     Float    @default(10)
  amountTtc   Float    @default(0)
  marginEst   Float?
  depositPercent  Float @default(0)
  depositAmountHt Float @default(0)
  /// N° bon de commande client
  customerPoNumber String?
  billingEmail String?
  luggageNotes String?
  accessibilityNotes String?
  optionsNotes String?
  costTolls       Float @default(0)
  costParking     Float @default(0)
  costDriverMeals Float @default(0)
  costHotel       Float @default(0)
  costMisc        Float @default(0)
  refusedReason String?
  requestReceivedAt DateTime?
  /// email | phone | postal | portal | other
  requestChannel String?
  proposedAt  DateTime?
  validUntil  DateTime?
  acceptedAt  DateTime?
  announcedAt DateTime?
  invoicedAt  DateTime?
  dayDetails  String?
  internalNotes String?
  publishedToPortal Boolean @default(false)
  publishedAt DateTime?
  availabilityNote String?
  availabilityConfidence String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines  QuoteLine[]
  order  Order?
  invoices Invoice[]

  @@unique([companyId, number])
}

model QuoteLine {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  /// transport | toll | parking | meal | hotel | option | other
  kind        String @default("transport")
  label       String
  /// forfait | km | heure | jour | pax | unite
  unit        String @default("forfait")
  quantity    Float  @default(1)
  unitPriceHt Float  @default(0)
  amountHt    Float  @default(0)
  sortOrder   Int    @default(0)
}

model Order {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  quoteId    String?  @unique
  quote      Quote?   @relation(fields: [quoteId], references: [id])
  salespersonId String?
  salesperson UserAccount? @relation("OrderSalesperson", fields: [salespersonId], references: [id])
  number     String
  /// confirmed | planned | in_progress | done | cancelled
  status     String   @default("confirmed")
  title      String
