}

model WorkOrder {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  number      String
  status      String   @default("diagnosed")
  diagnosis   String?
  laborHours  Float    @default(0)
  partsCost   Float    @default(0)
  immobilized Boolean  @default(false)
  closedAt    DateTime?
  createdAt   DateTime @default(now())

  links WorkOrderAlertLink[]
  tasks WorkOrderTask[]

  @@unique([companyId, number])
}

model WorkOrderAlertLink {
  id              String  @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  alertId         String?
  alert           MaintenanceAlert? @relation(fields: [alertId], references: [id])
  repairRequestId String?
  repairRequest   RepairRequest? @relation(fields: [repairRequestId], references: [id])
}

model WorkOrderTask {
  id          String @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  label       String
  done        Boolean @default(false)
  hours       Float   @default(0)
}

model Part {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  sku         String
  name        String
  brand       String?
  qty         Float    @default(0)
  minQty      Float    @default(1)
  unitCost    Float    @default(0)
  location    String?
  createdAt   DateTime @default(now())

  movements StockMovement[]

  @@unique([companyId, sku])
}

model StockMovement {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  partId    String
  part      Part     @relation(fields: [partId], references: [id])
  kind      String
  quantity  Float
  unitCost  Float    @default(0)
  note      String?
  workOrderId String?
  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  number      String
  supplier    String
  status      String   @default("ordered")
  linesJson   String   @default("[]")
  orderedAt   DateTime @default(now())
  deliveredAt DateTime?

  @@unique([companyId, number])
}

model FuelTransaction {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  filledAt    DateTime
  liters      Float
  amount      Float    @default(0)
  odometerKm  Int?
  source      String   @default("manual")
  status      String   @default("to_check")
  note        String?
  createdAt   DateTime @default(now())
}

/** Phase 7 — Qualité / BI / budgets */
model QualityClassification {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  level     String
  code      String
  label     String
  parentId  String?

  @@unique([companyId, level, code])
}

model Budget {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  year        Int
  source      String   @default("manual")
  version     Int      @default(1)
  linesJson   String   @default("[]")
  createdAt   DateTime @default(now())
}

model AnalyticsReport {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  dimensions  String   @default("[]")
  measures    String   @default("[]")
  filtersJson String   @default("{}")
  createdAt   DateTime @default(now())
}

model Simulation {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  status      String   @default("draft")
  payloadJson String   @default("{}")
  resultJson  String   @default("{}")
  createdAt   DateTime @default(now())
}

/** Phase 8 — Portail client */
model ClientAccountLink {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// owner | billing | ops
  portalRole String   @default("owner")
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model ClientPortalMessage {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?
  author     UserAccount? @relation(fields: [authorId], references: [id])
  /// client | staff
  authorKind String   @default("client")
  subject    String?
  body       String
  /// open | answered | closed
  status     String   @default("open")
  createdAt  DateTime @default(now())
  readAt     DateTime?

  @@index([companyId, customerId, createdAt])
}

model ClientQuoteRequest {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  customerId  String?
  contactName String
  email       String
  phone       String?
  /// occasionnel | scolaire | entreprise | evenement | autre
  tripType    String?  @default("occasionnel")
  origin      String?
  destination String?
  departureAt DateTime?
  returnAt    DateTime?
  passengers  Int      @default(0)
  vehicleHint String?
  budgetHint  String?
  message     String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
}
