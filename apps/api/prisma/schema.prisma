generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  tradeName String?
  siret     String?
  vatNumber String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  depots      Depot[]
  users       UserAccount[]
  groups      Group[]
  employees   Employee[]
  drivers     Driver[]
  customers   Customer[]
  vehicles    Vehicle[]
  locations   Location[]
  calendars   OperatingCalendar[]
  courses     Course[]
  services    Service[]
  quotes      Quote[]
  orders      Order[]
  missions    Mission[]
  assignments Assignment[]
  documents   GeneratedDocument[]
  threads     MessageThread[]
  incidents   QualityEvent[]
  leaves      LeaveRequest[]
  rests       PlannedRest[]
  alerts      OpsAlert[]
  invitations AccountInvitation[]
  permissions Permission[]
  itineraries Itinerary[]
  rosters     Roster[]
  theoreticalAssignments TheoreticalAssignment[]
  driverUnavs DriverUnavailability[]
  vehicleUnavs VehicleUnavailability[]
  dressingScenarios ServiceDressingScenario[]
  dressingRuns ServiceDressingRun[]
  timeBlocks  ServiceTimeBlock[]
  publicationBatches PlanningPublicationBatch[]
  invoices    Invoice[]
  payments    Payment[]
  credits     CustomerCredit[]
  prepRules   PrePayrollRule[]
  prepDaily   PrePayrollDailyLine[]
  prepWeekly  PrePayrollWeeklyLine[]
  prepMonthly PrePayrollMonthlyLine[]
  payrollCounters PayrollCounter[]
  payrollExports PayrollExportBatch[]
  maintenanceAlerts MaintenanceAlert[]
  repairRequests RepairRequest[]
  workOrders  WorkOrder[]
  parts       Part[]
  stockMoves  StockMovement[]
  purchaseOrders PurchaseOrder[]
  fuelTx      FuelTransaction[]
  qualityClasses QualityClassification[]
  budgets     Budget[]
  analyticsReports AnalyticsReport[]
  simulations Simulation[]
  clientRequests ClientQuoteRequest[]
}

model Depot {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  city      String?
  createdAt DateTime @default(now())

  employees Employee[]
  drivers   Driver[]
  vehicles  Vehicle[]
  memberships GroupMembership[]

  @@unique([companyId, code])
}

model UserAccount {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  email        String
  passwordHash String?
  displayName  String
  status       String   @default("not_created")
  mfaRequired  Boolean  @default(false)
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     UserSession[]
  memberships  GroupMembership[]
  invitations  AccountInvitation[]
  employeeLink EmployeeAccountLink?
  auditEvents  AccessAuditEvent[] @relation("ActorEvents")
  messages     Message[]
  leaveRequests LeaveRequest[]
  readReceipts PortalReadReceipt[]
  serviceEvents DriverServiceEvent[]

  @@unique([companyId, email])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenJti  String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

model AccountInvitation {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String
  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdById String?
  createdAt  DateTime @default(now())
}

model Group {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())

  memberships GroupMembership[]
  permissions GroupPermission[]

  @@unique([companyId, key])
}

model GroupMembership {
  id       String  @id @default(cuid())
  groupId  String
  group    Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  depotId  String?
  depot    Depot?  @relation(fields: [depotId], references: [id])
  createdAt DateTime @default(now())

  @@unique([groupId, userId, depotId])
}

model Permission {
  id        String  @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  key       String
  module    String
  resource  String
  action    String
  label     String
  sensitive Boolean @default(false)

  groups GroupPermission[]

  @@unique([companyId, key])
}

model GroupPermission {
  id           String @id @default(cuid())
  groupId      String
  group        Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scope        String @default("company")
  denied       Boolean @default(false)

  @@unique([groupId, permissionId])
}

model AccessAuditEvent {
  id         String   @id @default(cuid())
  companyId  String?
  actorId    String?
  actor      UserAccount? @relation("ActorEvents", fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  detailJson String?
  createdAt  DateTime @default(now())
}

model Employee {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  depotId        String?
  depot          Depot?   @relation(fields: [depotId], references: [id])
  matricule      String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  hiredAt        DateTime?
  contractHours  Float?
  status         String   @default("active")
  sensitiveNotes String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  driver       Driver?
  accountLink  EmployeeAccountLink?
  leaveRequests LeaveRequest[]

  @@unique([companyId, matricule])
}

model Driver {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  employeeId      String   @unique
  employee        Employee @relation(fields: [employeeId], references: [id])
  depotId         String?
  depot           Depot?   @relation(fields: [depotId], references: [id])
  licenseNumber   String?
  licenseExpiresAt DateTime?
  cardExpiresAt   DateTime?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments Assignment[]
  rests       PlannedRest[]
  serviceEvents DriverServiceEvent[]
  readReceipts PortalReadReceipt[]
  unavailabilities DriverUnavailability[]
  theoreticalAssignments TheoreticalAssignment[]
  rosterSlots RosterSlot[]
  dressingRuns ServiceDressingRun[]
}

model EmployeeAccountLink {
  id         String @id @default(cuid())
  employeeId String @unique
  employee   Employee @relation(fields: [employeeId], references: [id])
  userId     String @unique
  user       UserAccount @relation(fields: [userId], references: [id])
  portalRole String @default("driver")
  createdAt  DateTime @default(now())
}

model Customer {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  name            String
  type            String   @default("enterprise")
  siret           String?
  vatNumber       String?
  email           String?
  phone           String?
  billingAddress  String?
  paymentTermsDays Int     @default(30)
  notes           String?
  preferredVehicleNotes String?
  preferredDriverNotes  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts Contact[]
  quotes   Quote[]
  orders   Order[]
  invoices Invoice[]
  payments Payment[]
  credits  CustomerCredit[]
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String?
  phone      String?
  role       String?
  isBilling  Boolean  @default(false)
  isOps      Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Vehicle {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  depotId      String?
  depot        Depot?   @relation(fields: [depotId], references: [id])
  fleetNumber  String
  plate        String
  vin          String?
  brand        String?
  model        String?
  seats        Int      @default(53)
  energy       String   @default("diesel")
  status       String   @default("available")
  odometerKm   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments Assignment[]
  unavailabilities VehicleUnavailability[]
  theoreticalAssignments TheoreticalAssignment[]
  maintenanceAlerts MaintenanceAlert[]
  repairRequests RepairRequest[]
  workOrders WorkOrder[]
  fuelTx FuelTransaction[]

  @@unique([companyId, fleetNumber])
  @@unique([companyId, plate])
}

model Location {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  type      String   @default("stop")
  address   String?
  city      String?
  lat       Float?
  lng       Float?
  notes     String?
  accessMin Int      @default(5)
  createdAt DateTime @default(now())
}

model Itinerary {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  version     Int      @default(1)
  distanceKm  Float?
  durationMin Int?
  stopsJson   String   @default("[]")
  createdAt   DateTime @default(now())

  @@unique([companyId, code, version])
}

model OperatingCalendar {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  kind      String   @default("school")
  weekdays  String   @default("1,2,3,4,5")
  oddEven   String   @default("all")
  startDate DateTime?
  endDate   DateTime?
  exceptionsJson String @default("[]")
  createdAt DateTime @default(now())
}

model Course {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  kind        String   @default("regular")
  calendarId  String?
  distanceKm  Float?
  durationMin Int?
  createdAt   DateTime @default(now())

  segments   CourseSegment[]
  operations CourseOperation[]
  serviceLinks ServiceCourseLink[]
  theoreticalAssignments TheoreticalAssignment[]

  @@unique([companyId, code])
}

model CourseSegment {
  id         String @id @default(cuid())
  courseId   String
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sequence   Int
  kind       String @default("stop")
  locationId String?
  name       String
  plannedTime String?
  distanceKm Float?
}

model CourseOperation {
  id          String @id @default(cuid())
  courseId    String
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sequence    Int
  kind        String @default("run")
  label       String
  fromLocationId String?
  toLocationId   String?
  plannedStart String?
  plannedEnd   String?
  distanceKm   Float?
  durationMin  Int?
}

model Service {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  split       Boolean  @default(false)
  createdAt   DateTime @default(now())

  courseLinks ServiceCourseLink[]
  rosterSlots RosterSlot[]
  theoreticalAssignments TheoreticalAssignment[]
  dressingRuns ServiceDressingRun[]

  @@unique([companyId, code])
}

model ServiceCourseLink {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])
  sequence  Int
}

model Quote {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  number      String
  caseType    String   @default("simple")
  status      String   @default("draft")
  title       String
  departureAt DateTime?
  returnAt    DateTime?
  origin      String?
  destination String?
  passengers  Int      @default(0)
  amountHt    Float    @default(0)
  vatRate     Float    @default(10)
  amountTtc   Float    @default(0)
  marginEst   Float?
  availabilityNote String?
  availabilityConfidence String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order?

  @@unique([companyId, number])
}

model Order {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  quoteId    String?  @unique
  quote      Quote?   @relation(fields: [quoteId], references: [id])
  number     String
  status     String   @default("confirmed")
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  missions Mission[]

  @@unique([companyId, number])
}

model Mission {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  number       String
  status       String   @default("to_plan")
  title        String
  startsAt     DateTime
  endsAt       DateTime
  origin       String?
  destination  String?
  passengers   Int      @default(0)
  publishedAt  DateTime?
  ticketReturnedAt DateTime?
  ticketNotes  String?
  actualPassengers Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments Assignment[]
  documents   GeneratedDocument[]
  readReceipts PortalReadReceipt[]
  serviceEvents DriverServiceEvent[]

  @@unique([companyId, number])
}

model Assignment {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  missionId  String
  mission    Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id])
  vehicleId  String?
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  status     String   @default("draft")
  published  Boolean  @default(false)
  version    Int      @default(1)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GeneratedDocument {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  missionId   String?
  mission     Mission? @relation(fields: [missionId], references: [id])
  kind        String
  templateKey String
  templateVersion Int  @default(1)
  fileName    String
  storagePath String
  snapshotJson String?
  issuedAt    DateTime @default(now())
}

model MessageThread {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  subject   String
  status    String   @default("new")
  driverUserId String?
  missionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    UserAccount @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
  readAt    DateTime?
}

model QualityEvent {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  reportedById String?
  source      String   @default("driver")
  category    String
  nature      String?
  precision   String?
  overPrecision String?
  severity    String   @default("medium")
  description String
  missionId   String?
  vehicleNote String?
  status      String   @default("open")
  createdAt   DateTime @default(now())
}

model LeaveRequest {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  requesterId String
  requester  UserAccount @relation(fields: [requesterId], references: [id])
  type       String   @default("conges")
  startsOn   DateTime
  endsOn     DateTime
  comment    String?
  status     String   @default("submitted")
  decisionNote String?
  decidedAt  DateTime?
  createdAt  DateTime @default(now())
}

model PlannedRest {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  kind      String   @default("weekly_rest")
  startsAt  DateTime
  endsAt    DateTime
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PortalReadReceipt {
  id        String   @id @default(cuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])
  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id])
  kind      String   @default("planning_seen")
  createdAt DateTime @default(now())
}

model DriverServiceEvent {
  id        String   @id @default(cuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id])
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id])
  kind      String
  createdAt DateTime @default(now())
  note      String?
}

model OpsAlert {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  severity  String   @default("info")
  title     String
  body      String?
  href      String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

/** Phase 2 — Roulements cycliques */
model Roster {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  cycleDays   Int      @default(14)
  pattern     String   @default("A/B")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  slots      RosterSlot[]
  rotations  RosterRotation[]

  @@unique([companyId, code])
}

model RosterSlot {
  id         String  @id @default(cuid())
  rosterId   String
  roster     Roster  @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  dayOffset  Int
  label      String
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id])
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id])
  startTime  String   @default("07:00")
  endTime    String   @default("09:30")
}

model RosterRotation {
  id        String   @id @default(cuid())
  rosterId  String
  roster    Roster   @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  weekIndex Int
  label     String
  driverIdsJson String @default("[]")
}

/** Préaffectation théorique (≠ affectation publiée) */
model TheoreticalAssignment {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id])
  courseId   String?
  course     Course?  @relation(fields: [courseId], references: [id])
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id])
  vehicleId  String?
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])
  weekday    Int?
  validFrom  DateTime?
  validTo    DateTime?
  notes      String?
  createdAt  DateTime @default(now())
}

model DriverUnavailability {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  kind      String   @default("absence")
  reason    String?
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
}

model VehicleUnavailability {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  kind      String   @default("maintenance")
  reason    String?
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
}

model PlanningPublicationBatch {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  label       String
  fromDate    DateTime
  toDate      DateTime
  publishedAt DateTime @default(now())
  count       Int      @default(0)
  notes       String?
}

/** Phase 3 — Habillage / HLP */
model ServiceDressingScenario {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  version     Int      @default(1)
  active      Boolean  @default(true)
  depotLocationId String?
  prepMin     Int      @default(15)
  finishMin   Int      @default(10)
  cashMin     Int      @default(5)
  approachHlpMin Int   @default(20)
  returnHlpMin   Int   @default(20)
  paidBreakMin   Int   @default(0)
  rulesJson   String   @default("{}")
  createdAt   DateTime @default(now())

  runs ServiceDressingRun[]

  @@unique([companyId, code, version])
}

model ServiceDressingRun {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  scenarioId  String
  scenario    ServiceDressingScenario @relation(fields: [scenarioId], references: [id])
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  assignmentId String?
  driverId    String?
  driver      Driver?  @relation(fields: [driverId], references: [id])
  workDate    DateTime
  status      String   @default("draft")
  totalMin    Int      @default(0)
  totalKm     Float    @default(0)
  lockedBlocksJson String @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blocks ServiceTimeBlock[]
}

model ServiceTimeBlock {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  runId       String
  run         ServiceDressingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence    Int
  kind        String
  label       String
  startsAt    DateTime
  endsAt      DateTime
  distanceKm  Float    @default(0)
  paid        Boolean  @default(true)
  locked      Boolean  @default(false)
  fromLocation String?
  toLocation   String?
  notes       String?
}

/** Phase 4 — Facturation */
model Invoice {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  missionId        String?
  number           String
  kind             String   @default("standard")
  status           String   @default("draft")
  amountHt         Float    @default(0)
  vatRate          Float    @default(10)
  amountTtc        Float    @default(0)
  balance          Float    @default(0)
  relatedInvoiceId String?
  notes            String?
  issuedAt         DateTime @default(now())
  createdAt        DateTime @default(now())

  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@unique([companyId, number])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label       String
  quantity    Float   @default(1)
  unitPriceHt Float   @default(0)
  amountHt    Float   @default(0)
}

model Payment {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Float
  method     String   @default("transfer")
  paidAt     DateTime @default(now())
  notes      String?

  allocations PaymentAllocation[]
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Float
}

model CustomerCredit {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  amount          Float
  remaining       Float
  sourcePaymentId String?
  notes           String?
  createdAt       DateTime @default(now())
}

/** Phase 5 — Prépaye */
model PrePayrollRule {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  label       String
  period      String   @default("daily")
  formula     String
  priority    Int      @default(100)
  validFrom   DateTime?
  validTo     DateTime?
  active      Boolean  @default(true)
  exampleJson String   @default("{}")
  createdAt   DateTime @default(now())

  @@unique([companyId, code])
}

model PrePayrollDailyLine {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  employeeId  String
  workDate    DateTime
  ruleCode    String
  label       String
  quantity    Float    @default(0)
  amount      Float    @default(0)
  source      String   @default("planning")
  detailJson  String   @default("{}")
  checked     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model PrePayrollWeeklyLine {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  employeeId  String
  weekStart   DateTime
  ruleCode    String
  label       String
  quantity    Float    @default(0)
  amount      Float    @default(0)
  checked     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model PrePayrollMonthlyLine {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  employeeId  String
  yearMonth   String
  ruleCode    String
  label       String
  quantity    Float    @default(0)
  amount      Float    @default(0)
  checked     Boolean  @default(false)
  exported    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model PayrollCounter {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  employeeId  String
  code        String
  label       String
  balance     Float    @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([companyId, employeeId, code])
}

model PayrollExportBatch {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  yearMonth   String
  status      String   @default("draft")
  lineCount   Int      @default(0)
  payloadJson String   @default("[]")
  createdAt   DateTime @default(now())
  exportedAt  DateTime?
}

/** Phase 6 — Atelier / stocks / carburant */
model MaintenanceAlert {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  kind        String   @default("km")
  title       String
  dueAt       DateTime?
  dueKm       Int?
  priority    String   @default("medium")
  status      String   @default("open")
  createdAt   DateTime @default(now())

  workOrderLinks WorkOrderAlertLink[]
}

model RepairRequest {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  source      String   @default("driver")
  title       String
  description String
  priority    String   @default("medium")
  status      String   @default("reported")
  createdAt   DateTime @default(now())

  workOrderLinks WorkOrderAlertLink[]
}

model WorkOrder {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  number      String
  status      String   @default("diagnosed")
  diagnosis   String?
  laborHours  Float    @default(0)
  partsCost   Float    @default(0)
  immobilized Boolean  @default(false)
  closedAt    DateTime?
  createdAt   DateTime @default(now())

  links WorkOrderAlertLink[]
  tasks WorkOrderTask[]

  @@unique([companyId, number])
}

model WorkOrderAlertLink {
  id              String  @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  alertId         String?
  alert           MaintenanceAlert? @relation(fields: [alertId], references: [id])
  repairRequestId String?
  repairRequest   RepairRequest? @relation(fields: [repairRequestId], references: [id])
}

model WorkOrderTask {
  id          String @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  label       String
  done        Boolean @default(false)
  hours       Float   @default(0)
}

model Part {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  sku         String
  name        String
  brand       String?
  qty         Float    @default(0)
  minQty      Float    @default(1)
  unitCost    Float    @default(0)
  location    String?
  createdAt   DateTime @default(now())

  movements StockMovement[]

  @@unique([companyId, sku])
}

model StockMovement {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  partId    String
  part      Part     @relation(fields: [partId], references: [id])
  kind      String
  quantity  Float
  unitCost  Float    @default(0)
  note      String?
  workOrderId String?
  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  number      String
  supplier    String
  status      String   @default("ordered")
  linesJson   String   @default("[]")
  orderedAt   DateTime @default(now())
  deliveredAt DateTime?

  @@unique([companyId, number])
}

model FuelTransaction {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  filledAt    DateTime
  liters      Float
  amount      Float    @default(0)
  odometerKm  Int?
  source      String   @default("manual")
  status      String   @default("to_check")
  note        String?
  createdAt   DateTime @default(now())
}

/** Phase 7 — Qualité / BI / budgets */
model QualityClassification {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  level     String
  code      String
  label     String
  parentId  String?

  @@unique([companyId, level, code])
}

model Budget {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  year        Int
  source      String   @default("manual")
  version     Int      @default(1)
  linesJson   String   @default("[]")
  createdAt   DateTime @default(now())
}

model AnalyticsReport {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  dimensions  String   @default("[]")
  measures    String   @default("[]")
  filtersJson String   @default("{}")
  createdAt   DateTime @default(now())
}

model Simulation {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  status      String   @default("draft")
  payloadJson String   @default("{}")
  resultJson  String   @default("{}")
  createdAt   DateTime @default(now())
}

/** Phase 8 — Portail client */
model ClientQuoteRequest {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  customerId  String?
  contactName String
  email       String
  phone       String?
  origin      String?
  destination String?
  departureAt DateTime?
  passengers  Int      @default(0)
  message     String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
}
