{
  "name": "autocar-os",
  "private": true,
  "version": "0.1.0",
  "description": "AUTOCAR OS — ERP transport de voyageurs",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @autocar/api --filter @autocar/web run dev",
    "build": "pnpm -r run build",
    "test": "pnpm --filter @autocar/api test",
    "db:generate": "pnpm --filter @autocar/api db:generate",
    "db:migrate": "pnpm --filter @autocar/api db:migrate",
    "db:seed": "pnpm --filter @autocar/api db:seed",
    "db:reset": "pnpm --filter @autocar/api db:reset",
    "lint": "pnpm -r run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
